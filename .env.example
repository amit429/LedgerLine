# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose to the client,
# never prefix with NEXT_PUBLIC_. Used only in scripts/seed-demo-user.ts
# and any admin-only server route.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API key, server-only. Used to generate plain-language explanations
# of already-computed reconciliation results — never used to decide matches.
OPENAI_API_KEY=
